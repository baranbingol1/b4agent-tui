{
  "name": "b4agent-tui",
  "version": "0.0.0",
  "private": true,
  "description": "b4agent: an opinionated coding harness built as Pi extensions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:reviewer": "tsc -p tsconfig.json && node dist/eval/reviewer/run.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.1.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typebox": "1.3.27",
    "unbash": "6.0.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.6",
    "tuistory": "0.12.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "bin": {
    "b4agent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "agents",
    "prompt",
    "skills",
    "themes",
    "NOTICE",
    "vendor.json"
  ]
}
